{
  "name": "boardgame-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @boardgame/api --filter @boardgame/web dev",
    "build": "pnpm -r --if-present build && node scripts/check-production-bundle.mjs && node --conditions=production scripts/check-api-runtime.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && tsx scripts/check-boundaries.ts",
    "test": "vitest run",
    "test:integration": "tsx --env-file=.env scripts/prepare-test-db.ts && tsx --env-file=.env scripts/migrate.ts --test && tsx --env-file=.env scripts/sync-games.ts --test && tsx --env-file=.env scripts/seed-assets.ts --test && vitest run tests/integration",
    "test:developers": "playwright test --config playwright.developers.config.ts",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "test:e2e": "pnpm db:test:prepare && tsx --env-file=.env scripts/migrate.ts --test && tsx --env-file=.env scripts/sync-games.ts --test && tsx --env-file=.env scripts/seed-assets.ts --test && tsx --env-file=.env scripts/run-e2e.ts",
    "db:up": "docker compose -f compose.dev.yml up -d postgres",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:test:prepare": "tsx --env-file=.env scripts/prepare-test-db.ts",
    "games:sync": "tsx --env-file=.env scripts/sync-games.ts",
    "account": "tsx --env-file=.env scripts/accounts.ts",
    "assets:seed": "tsx --env-file=.env scripts/seed-assets.ts",
    "assets:check": "tsx --env-file=.env scripts/assets-integrity.ts"
  },
  "devDependencies": {
    "@boardgame/game-sdk": "workspace:*",
    "@boardgame/color-match": "workspace:*",
    "@boardgame/grid-garden": "workspace:*",
    "@boardgame/splendor": "workspace:*",
    "@boardgame/test-counter": "workspace:*",
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.0",
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "argon2": "0.45.1",
    "eslint": "9.35.0",
    "pg": "8.16.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4",
    "ws": "8.18.3",
    "zod": "4.1.5"
  }
}
